<?xml version="1.0" encoding="utf-8"?>
<!-- Custom comic card (DecoratedCustomViewStyle). Background swapped per variant in PqNotify.card().
     Fonts: res/font/bangers_regular, rubik_extrabold, rubik_medium (Pixel: press_start_2p, pixelify_sans_medium). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pix_card"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/pix_card_gold">
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/pix_kicker"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAllCaps="true" android:letterSpacing="0.1" android:textSize="10sp"
            android:textColor="@color/pix_ink" android:fontFamily="@font/rubik_extrabold"/>
        <TextView android:id="@+id/pix_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textSize="30sp" android:textColor="@color/pix_red" android:fontFamily="@font/bangers_regular"
            android:shadowColor="@color/pix_ink" android:shadowDx="3" android:shadowDy="3" android:shadowRadius="0.01"/>
        <TextView android:id="@+id/pix_body"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textSize="13sp" android:textColor="@color/pix_ink" android:fontFamily="@font/rubik_medium"/>
        <ProgressBar android:id="@+id/pix_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp"
            android:progressTint="@color/pix_red" android:progressBackgroundTint="@color/pix_paper"
            android:visibility="gone"/>
    </LinearLayout>
    <ImageView android:id="@+id/pix_mascot"
        android:layout_width="72dp" android:layout_height="72dp" android:layout_marginStart="10dp"
        android:contentDescription="@null"/>
</LinearLayout>
