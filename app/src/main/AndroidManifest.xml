<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Day 26: lets PROMPT-style reminders open the "did you do it?" screen over the lock screen.
         Android 14+ may deny it for non-alarm apps; the reminder then shows as a heads-up instead. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Namaz Tracker: rough (city-level) location for prayer times, asked for only when the player
         turns it on or taps Use my location (docs/namaz-design.md). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Study timer foreground service (docs/study-timer.md) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".PixelQuestApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:targetApi="31"
        android:label="PixelQuest"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelQuest">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PixelQuest" />

        <activity-alias
            android:name=".LauncherPixHappy"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pix_happy"
            android:roundIcon="@mipmap/ic_launcher_pix_happy"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixOnFire"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pix_onfire"
            android:roundIcon="@mipmap/ic_launcher_pix_onfire"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixWorried"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pix_worried"
            android:roundIcon="@mipmap/ic_launcher_pix_worried"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixSad"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pix_sad"
            android:roundIcon="@mipmap/ic_launcher_pix_sad"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPixSleepy"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pix_sleepy"
            android:roundIcon="@mipmap/ic_launcher_pix_sleepy"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".notification.PqNotifyActions"
            android:exported="false" />

        <activity
            android:name=".ui.prompt.TaskPromptActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.PixelQuest" />

        <activity
            android:name=".study.alarm.StudyPromptActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.PixelQuest" />

        <receiver
            android:name=".study.alarm.StudyDueAlarmReceiver"
            android:exported="false" />

        <!-- Push for chess challenges (docs/chess-design.md): only Firebase delivers to it. -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".scheduling.TaskAlarmReceiver"
            android:exported="false" />

        <!-- Not exported (S040): only the system sends it these broadcasts, and system broadcasts reach
             non-exported receivers. Another app can't make it re-arm alarms. -->
        <receiver
            android:name=".scheduling.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An update: re-arm in case the new version's alarms differ (Namaz reminders, docs/namaz-design.md). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Re-arm reminders as exact alarms once the user allows "Alarms & reminders". -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- Alarms are absolute times: re-arm when the time zone or the clock changes. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".notification.TaskActionReceiver"
            android:exported="false" />

        <!-- Namaz Tracker: the prayer alarms (docs/namaz-design.md, Reminders). -->
        <receiver
            android:name=".namaz.NamazAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".namaz.NamazActionReceiver"
            android:exported="false" />
        <!-- Study reminders' alerts (docs/study-reminders.md, On the phone). -->
        <receiver
            android:name=".study.alarm.StudyReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".study.alarm.StudyReminderActionReceiver"
            android:exported="false" />

        <!-- Study timer foreground service (docs/study-timer.md) -->
        <service
            android:name=".study.timer.StudyTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Study timer recording active focused study session duration" />
        </service>

        <!-- WorkManager is initialised by PixelQuestApplication with HiltWorkerFactory, so the
             @HiltWorker workers (missed tasks, streaks, sync, AI) can be constructed. -->
        <!-- The study chat's opened files, to the system viewer the player picks: their cache folder only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.studyfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/study_file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
