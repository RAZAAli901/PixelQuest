<?xml version="1.0" encoding="utf-8"?>
<!--
    A study party's own text (docs/study-party.md): its tabs, items, ticks, study time and board.
    What every party says alike is in strings_party.xml.

    For translators: <xliff:g> marks a value filled in by the app; keep it, move it where your
    grammar needs it, and leave what's inside unchanged. Its example shows what the app puts there.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The party screen's tabs. -->
    <string name="study_tab_this_week">This week</string>
    <string name="study_tab_all_items">All items</string>
    <string name="study_tab_scoreboard">Scoreboard</string>
    <string name="study_tab_people">People</string>
    <!-- The top bar's button that opens the party's info (members, leader actions). -->
    <string name="study_open_info">Party info</string>
    <string name="study_add_people">Add people</string>
    <!-- Nothing to show on a tab. -->
    <string name="study_week_empty">Nothing due this week. Add an assignment or quiz so the party can see it.</string>
    <string name="study_items_empty">No items yet. Add what\'s due, and everyone in the party will see it.</string>
    <string name="study_board_empty">No points yet this week. Finish an item or log study time to get on the board.</string>
    <!-- A line on the scoreboard: place, member, their points ("1. @aria_k, 25 points"). -->
    <string name="study_board_line"><xliff:g id="place" example="1">%1$d</xliff:g>. <xliff:g id="member" example="\@aria_k">%2$s</xliff:g>, <xliff:g id="points" example="25 points">%3$s</xliff:g></string>
    <plurals name="study_points">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> point</item>
        <item quantity="other"><xliff:g id="count" example="25">%d</xliff:g> points</item>
    </plurals>
    <!-- This week's summary: items the player has finished of this week's ("2 of 5 done this week"). -->
    <string name="study_week_progress"><xliff:g id="done" example="2">%1$d</xliff:g> of <xliff:g id="total" example="5">%2$d</xliff:g> done this week</string>
    <!-- The player's points so far this week ("25 points so far"). -->
    <string name="study_week_points"><xliff:g id="points" example="25 points">%1$s</xliff:g> so far</string>
    <!-- This week's headings. -->
    <string name="study_section_overdue">Overdue</string>
    <string name="study_section_today">Today</string>
    <string name="study_section_tomorrow">Tomorrow</string>
    <string name="study_section_no_date">No due date</string>
    <!-- An item's card. -->
    <string name="study_kind_assignment">📝 Assignment</string>
    <string name="study_kind_quiz">❓ Quiz</string>
    <string name="study_pinned">Pinned by the leader</string>
    <string name="study_open_item">Open item</string>
    <!-- When it's due: day, then time ("Due Fri 23 Oct, 17:00"). -->
    <string name="study_due_at">Due <xliff:g id="day" example="Fri 23 Oct">%1$s</xliff:g>, <xliff:g id="time" example="17:00">%2$s</xliff:g></string>
    <string name="study_due_today">Due today, <xliff:g id="time" example="17:00">%1$s</xliff:g></string>
    <string name="study_due_overdue">Overdue: due <xliff:g id="day" example="Mon 19 Oct">%1$s</xliff:g>, <xliff:g id="time" example="09:00">%2$s</xliff:g></string>
    <!-- How many in the party have finished it, of its members ("3 of 5 finished"). -->
    <string name="study_item_done_count"><xliff:g id="done" example="3">%1$d</xliff:g> of <xliff:g id="members" example="5">%2$d</xliff:g> finished</string>
    <!-- The player's own tick on it. -->
    <string name="study_item_done">✓ Done</string>
    <string name="study_item_waiting">✓ Waiting to send</string>
    <string name="study_item_refused">Not saved</string>
    <!-- The strip of the leader's pinned items, and one of them ("📌 Waves quiz"). -->
    <string name="study_pinned_title">Pinned</string>
    <string name="study_pinned_line">📌 <xliff:g id="title" example="Waves quiz">%1$s</xliff:g></string>
    <!-- The Add item and Edit item sheet. -->
    <string name="study_add_item">Add item</string>
    <string name="study_edit_item">Edit item</string>
    <string name="study_field_title">Title</string>
    <string name="study_field_subject">Subject (optional)</string>
    <string name="study_field_notes">Notes (optional)</string>
    <string name="study_field_due">Due</string>
    <string name="study_field_pin">Pin it for the party</string>
    <string name="study_title_short">A title needs at least 2 characters.</string>
    <string name="study_quiz_needs_date">A quiz needs a due date.</string>
    <string name="study_add_item_save">Add it</string>
    <string name="study_edit_item_save">Save changes</string>
    <!-- Ticking an item off, and taking it back (for 24 hours); a refused tick, tried again or dropped. -->
    <string name="study_mark_done">Mark done</string>
    <string name="study_undo">Undo</string>
    <string name="study_try_again">Try again</string>
    <string name="study_drop">Drop it</string>
    <!-- An item's ⋯ menu, for its creator or the leader. -->
    <string name="study_item_actions">Item actions</string>
    <string name="study_edit">Edit</string>
    <string name="study_pin">Pin for the party</string>
    <string name="study_unpin">Unpin</string>
    <string name="study_delete">Delete</string>
    <string name="study_keep">Keep it</string>
    <!-- Asking to be sure before an item goes ("Delete Waves quiz?"). -->
    <string name="study_delete_title">Delete this item?</string>
    <string name="study_delete_message"><xliff:g id="title" example="Waves quiz">%1$s</xliff:g> will go for everyone in the party, with everyone\'s ticks on it.</string>
    <!-- The study timer, and minutes added by hand. -->
    <string name="study_timer_title">Study time</string>
    <!-- The player's minutes today in this party ("65 minutes today"). -->
    <plurals name="study_minutes_today">
        <item quantity="one"><xliff:g id="minutes" example="1">%d</xliff:g> minute today</item>
        <item quantity="other"><xliff:g id="minutes" example="65">%d</xliff:g> minutes today</item>
    </plurals>
    <string name="study_timer_start">Start timer</string>
    <string name="study_timer_stop">Stop and log</string>
    <string name="study_timer_cancel">Cancel</string>
    <!-- The timer running: how long so far ("Studying: 25:03"). -->
    <string name="study_timer_running">Studying: <xliff:g id="elapsed" example="25:03">%1$s</xliff:g></string>
    <string name="study_timer_elsewhere">A timer is running in another party. Stop it there first.</string>
    <string name="study_timer_too_short">Under 5 minutes, so nothing was logged.</string>
    <string name="study_add_minutes">Or add minutes you studied:</string>
    <!-- A choice of minutes to add ("25 min"). -->
    <string name="study_minutes_chip"><xliff:g id="minutes" example="25">%d</xliff:g> min</string>
    <!-- Logging the chosen minutes ("Log 25 minutes"). -->
    <plurals name="study_log_minutes">
        <item quantity="one">Log <xliff:g id="minutes" example="1">%d</xliff:g> minute</item>
        <item quantity="other">Log <xliff:g id="minutes" example="25">%d</xliff:g> minutes</item>
    </plurals>
    <!-- The activity feed, at the end of This week. -->
    <string name="study_activity_title">Recent activity</string>
    <!-- The player, in a feed line ("You finished Waves quiz"). -->
    <string name="study_activity_you">You</string>
    <string name="study_activity_added"><xliff:g id="member" example="\@aria_k">%1$s</xliff:g> added <xliff:g id="title" example="Waves quiz">%2$s</xliff:g></string>
    <string name="study_activity_finished"><xliff:g id="member" example="\@bram">%1$s</xliff:g> finished <xliff:g id="title" example="Waves quiz">%2$s</xliff:g></string>
    <plurals name="study_activity_studied">
        <item quantity="one"><xliff:g id="member" example="\@bram">%1$s</xliff:g> studied for <xliff:g id="minutes" example="1">%2$d</xliff:g> minute</item>
        <item quantity="other"><xliff:g id="member" example="\@bram">%1$s</xliff:g> studied for <xliff:g id="minutes" example="25">%2$d</xliff:g> minutes</item>
    </plurals>
    <!-- When it happened ("Wed 21 Oct, 15:00"). -->
    <string name="study_activity_when"><xliff:g id="day" example="Wed 21 Oct">%1$s</xliff:g>, <xliff:g id="time" example="15:00">%2$s</xliff:g></string>
    <!-- One item's own screen. -->
    <string name="study_item_notes">Notes</string>
    <!-- Who added it ("Added by @aria_k"). -->
    <string name="study_item_added_by">Added by <xliff:g id="member" example="\@aria_k">%1$s</xliff:g></string>
    <string name="study_item_who_done">Who has finished it</string>
    <string name="study_item_nobody_done">Nobody yet. Be the first!</string>
    <!-- A member who finished it, and when ("@bram, Wed 21 Oct"). -->
    <string name="study_item_done_by"><xliff:g id="member" example="\@bram">%1$s</xliff:g>, <xliff:g id="day" example="Wed 21 Oct">%2$s</xliff:g></string>
    <string name="study_item_gone">This item was deleted.</string>
    <!-- The Scoreboard tab: the week it shows ("Mon 19 Oct to Sun 25 Oct"). -->
    <string name="study_board_week"><xliff:g id="from" example="Mon 19 Oct">%1$s</xliff:g> to <xliff:g id="to" example="Sun 25 Oct">%2$s</xliff:g></string>
    <!-- A place on the board ("1"); equal points share a place. -->
    <string name="study_board_place"><xliff:g id="place" example="1">%d</xliff:g></string>
    <!-- The player's own line ("@aria_k (you)"). -->
    <string name="study_board_you"><xliff:g id="member" example="\@aria_k">%1$s</xliff:g> (you)</string>
    <!-- Where a member's points came from ("3 items, 5 bonus, 65 minutes"). -->
    <string name="study_board_breakdown"><xliff:g id="items" example="3 items">%1$s</xliff:g>, <xliff:g id="bonus" example="5">%2$d</xliff:g> bonus, <xliff:g id="minutes" example="65 minutes">%3$s</xliff:g></string>
    <plurals name="study_items_done">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> item</item>
        <item quantity="other"><xliff:g id="count" example="3">%d</xliff:g> items</item>
    </plurals>
    <plurals name="study_minutes">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> minute</item>
        <item quantity="other"><xliff:g id="count" example="65">%d</xliff:g> minutes</item>
    </plurals>
    <!-- Last week's winners, over the party until dismissed. -->
    <string name="study_winner_title">🏆 Last week\'s winner</string>
    <string name="study_winner_you">🏆 You won last week!</string>
    <!-- Who won and with how many points ("@bram, with 40 points"; ties: "@bram, @cleo, with 40 points each"). -->
    <plurals name="study_winner_line">
        <item quantity="one"><xliff:g id="members" example="\@bram">%1$s</xliff:g>, with <xliff:g id="points" example="40 points">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g id="members" example="\@bram, \@cleo">%1$s</xliff:g>, with <xliff:g id="points" example="40 points">%2$s</xliff:g> each</item>
    </plurals>
    <string name="study_winner_dismiss">Nice! Dismiss</string>
    <!-- The weeks gone by, under the board. -->
    <string name="study_past_weeks">Past weeks</string>
    <plurals name="study_past_winner">
        <item quantity="one">🏆 <xliff:g id="members" example="\@bram">%1$s</xliff:g>, <xliff:g id="points" example="40 points">%2$s</xliff:g></item>
        <item quantity="other">🏆 <xliff:g id="members" example="\@bram, \@cleo">%1$s</xliff:g>, <xliff:g id="points" example="40 points">%2$s</xliff:g> each</item>
    </plurals>
    <string name="study_past_no_winner">No winner: nobody scored, or the week isn\'t closed yet.</string>
    <!-- The player's own points that week ("You: 25 points"). -->
    <string name="study_past_mine">You: <xliff:g id="points" example="25 points">%1$s</xliff:g></string>
    <!-- How points are earned. -->
    <string name="study_points_title">How points work</string>
    <string name="study_points_assignment">An assignment done: <xliff:g id="points" example="10">%d</xliff:g></string>
    <string name="study_points_quiz">A quiz done: <xliff:g id="points" example="15">%d</xliff:g></string>
    <string name="study_points_early">Done a day or more early: <xliff:g id="points" example="5">%d</xliff:g> more</string>
    <string name="study_points_study">Study time: 1 for every <xliff:g id="minutes" example="10">%1$d</xliff:g> minutes, up to <xliff:g id="max" example="12">%2$d</xliff:g> a day</string>
    <string name="study_points_not_xp">These points are this party\'s own. They never change your XP, level or streak.</string>
    <!-- While the party is loading for the first time. -->
    <string name="study_loading">Loading the party…</string>
    <!-- What happened to something the player just tried. -->
    <string name="study_offline">No connection. Ticks and study time are saved on this phone and sent when it\'s back.</string>
    <string name="study_refused_not_allowed">Only the person who added it, or the party leader, can do that. A tick can be undone for 24 hours only.</string>
    <string name="study_refused_not_leader">Only the party leader can pin items.</string>
    <string name="study_refused_bad_day">That day is too far back to count.</string>
    <string name="study_refused_no_item">That item was deleted.</string>
    <string name="study_refused_other">The party couldn\'t save that. Check it and try again.</string>
</resources>
