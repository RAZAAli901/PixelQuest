        <item quantity="one"><xliff:g id="members" example="\@bram">%1$s</xliff:g>, with <xliff:g id="points" example="40 points">%2$s</xliff:g></item>
        <item quantity="other"><xliff:g id="members" example="\@bram, \@cleo">%1$s</xliff:g>, with <xliff:g id="points" example="40 points">%2$s</xliff:g> each</item>
    </plurals>
    <string name="study_winner_dismiss">Nice! Dismiss</string>
