<?xml version="1.0" encoding="utf-8"?>
<!--
    The Islamic hub's text (docs/islamic-hub.md), all in this file.

    For translators:
    - "Namaz", "Darood" and "Quran" are proper names: keep the forms your language uses for them.
    - <xliff:g> marks a value filled in by the app; keep it, move it where your grammar needs it,
      and leave what's inside unchanged. Its example shows what the app puts there.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- The Deen tab (UI v2, mock 2D): the Islamic section's landing screen. -->
    <string name="pq_deen_title">Deen</string>
    <!-- What tapping a tile does, as TalkBack says it ("double-tap to open"). -->
    <string name="islamic_card_open">open</string>
    <string name="pq_deen_next_prayer">NEXT PRAYER</string>
    <!-- Days in a row with all five prayers prayed. -->
    <plurals name="pq_deen_all_five">
        <item quantity="one"><xliff:g id="days" example="1">%d</xliff:g> day all five</item>
        <item quantity="other"><xliff:g id="days" example="2">%d</xliff:g> days all five</item>
    </plurals>
    <string name="pq_deen_open_tracker">Open Namaz tracker</string>
    <!-- The Quran tile, once the player has read: "Continue Al-Baqara · ayah 142". -->
    <string name="pq_deen_quran_continue">Continue <xliff:g id="surah" example="Al-Baqara">%1$s</xliff:g> · ayah <xliff:g id="ayah" example="142">%2$d</xliff:g></string>

    <!-- What TalkBack says for a card, which is one button: its title, then its description. -->
    <string name="islamic_card_spoken"><xliff:g id="title" example="Darood Party">%1$s</xliff:g>. <xliff:g id="description" example="Count Darood together with friends">%2$s</xliff:g></string>
    <!-- The same with its badge, in words (islamic_namaz_badge, islamic_darood_badge). -->
    <string name="islamic_card_spoken_badge"><xliff:g id="title" example="Darood Party">%1$s</xliff:g>. <xliff:g id="description" example="Count Darood together with friends">%2$s</xliff:g>. <xliff:g id="badge" example="1 invitation waiting">%3$s</xliff:g></string>

    <!-- A card after the items in debug builds only, where a new item will appear. -->
    <string name="islamic_coming_soon_title">More coming soon</string>
    <string name="islamic_coming_soon_body">New Islamic features will appear here</string>

    <!-- The Namaz Tracker's card. Its title is namaz_title. -->
    <string name="islamic_namaz_description">Prayer times, reminders and your week</string>
    <!-- Its badge, as TalkBack reads it: today's prayers whose time has come and that aren't marked prayed. -->
    <plurals name="islamic_namaz_badge">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> prayer to mark</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> prayers to mark</item>
    </plurals>

    <!-- Darood Party's card. Its title is darood_title. -->
    <string name="islamic_darood_description">Count Darood together with friends</string>
    <!-- Its badge, as TalkBack reads it: invitations to a party waiting for an answer. -->
    <plurals name="islamic_darood_badge">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> invitation waiting</item>
        <item quantity="other"><xliff:g id="count" example="2">%d</xliff:g> invitations waiting</item>
    </plurals>
    <!-- Settings: the Islamic section. -->
    <string name="settings_islamic_title">🕌 ISLAMIC</string>
    <string name="settings_islamic_show">Show the Islamic section</string>
    <string name="settings_islamic_show_body">Its side menu entry, and the Namaz card on Home. Turned off, they\'re hidden; what you\'ve saved stays, and comes back when it\'s on.</string>
    <string name="settings_islamic_quran">Quran reading</string>
    <string name="settings_islamic_quran_body">How the reader opens each surah. You can still change these from the reader.</string>
    <string name="settings_islamic_reminders">Reminders</string>
    <string name="settings_islamic_namaz_reminders">Prayer reminders are set in the Namaz Tracker, one by one.</string>
</resources>
