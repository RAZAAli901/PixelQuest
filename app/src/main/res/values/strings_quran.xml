<?xml version="1.0" encoding="utf-8"?>
<!--
    The Quran reader's text (docs/islamic-hub.md), all in this file. The Quran's own text and its
    translation are never here: they're bundled data, shown exactly as their source gives them.

    For translators:
    - "Quran" is a proper name: keep the form your language uses for it.
    - Surah names come from the Quran's data, never from this file.
    - <xliff:g> marks a value filled in by the app; keep it, move it where your grammar needs it,
      and leave what's inside unchanged. Its example shows what the app puts there.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Its card on the Islamic hub, and its screen's title. -->
    <string name="quran_title">Quran</string>
    <string name="quran_description">Read the Quran in Arabic and English</string>
    <!-- Shown once, the first time: the Quran is being put on the phone from the app's own files. -->
    <string name="quran_preparing_title">Preparing the Quran</string>
    <string name="quran_preparing_body">This happens once, on your phone, and takes a few seconds. After that the Quran opens without the internet.</string>
    <!-- If that ever fails (the app's files are damaged). Opening the app again tries again. -->
    <string name="quran_preparing_failed_title">The Quran couldn\'t be prepared</string>
    <string name="quran_preparing_failed_body">Close PixelQuest and open it again to try again.</string>

    <!-- The surah list. -->
    <string name="quran_surah_search">Search by name or number</string>
    <string name="quran_surah_none">No surah matches that</string>
    <!-- Where a surah was revealed: Tanzil's terms, kept as the usual English names. -->
    <string name="quran_meccan">Meccan</string>
    <string name="quran_medinan">Medinan</string>
    <plurals name="quran_ayah_count">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> ayah</item>
        <item quantity="other"><xliff:g id="count" example="286">%d</xliff:g> ayahs</item>
    </plurals>
    <!-- What TalkBack calls the Bismillah above a surah (it reads the Arabic as written). -->
    <string name="quran_bismillah">Bismillah</string>
    <!-- The reading settings' sliders. -->
    <string name="quran_setting_arabic_size">Arabic size</string>
    <string name="quran_setting_translation_size">Translation size</string>
    <string name="quran_setting_line_spacing">Line spacing</string>
    <!-- What the reader shows of each ayah: the Arabic, both, or the translation. -->
    <string name="quran_mode_arabic">Arabic</string>
    <string name="quran_mode_both">Both</string>
    <string name="quran_mode_translation">Translation</string>
    <!-- The page the reader's text is on: the look's own (dark at night in dark looks), or sepia. -->
    <string name="quran_paper">Page</string>
    <string name="quran_paper_theme">Theme</string>
    <string name="quran_paper_sepia">Sepia</string>
    <!-- At a surah's end: the one before it and the one after, by their English names. -->
    <string name="quran_previous_surah">◀ <xliff:g id="surah" example="Al-Faatiha">%s</xliff:g></string>
    <string name="quran_next_surah"><xliff:g id="surah" example="Aal-i-Imraan">%s</xliff:g> ▶</string>
    <!-- An ayah's sheet: its reference (surah's English name, surah number, ayah number), then its actions. -->
    <string name="quran_ayah_reference"><xliff:g id="surah_name" example="Al-Baqara">%1$s</xliff:g> <xliff:g id="surah" example="2">%2$d</xliff:g>:<xliff:g id="ayah" example="255">%3$d</xliff:g></string>
    <string name="quran_ayah_open_actions">show what you can do with it</string>
    <string name="quran_bookmark">Bookmark</string>
    <string name="quran_unbookmark">Remove bookmark</string>
    <!-- A bookmarked ayah's state, as TalkBack says it. -->
    <string name="quran_bookmarked">Bookmarked</string>
    <string name="quran_copy_arabic">Copy the Arabic</string>
    <string name="quran_copy_translation">Copy the translation</string>
    <string name="quran_share">Share</string>
    <!-- After a copy, briefly. -->
    <string name="quran_copied">Copied</string>
    <!-- What follows an ayah copied or shared: its reference, whose translation it is, and where the
         Arabic is from (Tanzil's terms ask for its name and site). The ayah itself is never changed. -->
    <string name="quran_share_reference">— <xliff:g id="surah_name" example="Al-Baqara">%1$s</xliff:g> <xliff:g id="surah" example="2">%2$d</xliff:g>:<xliff:g id="ayah" example="255">%3$d</xliff:g></string>
    <string name="quran_share_translation_credit">Translation: <xliff:g id="translator" example="Saheeh International">%s</xliff:g></string>
    <string name="quran_share_text_credit">Quran text: Tanzil.net</string>
    <!-- The card at the top of the Quran screen, back to the last place read. -->
    <string name="quran_continue_title">Continue reading</string>
    <string name="quran_continue_place"><xliff:g id="number" example="2">%1$d</xliff:g>. <xliff:g id="name" example="Al-Baqara">%2$s</xliff:g>, ayah <xliff:g id="ayah" example="255">%3$d</xliff:g></string>
    <!-- About and Sources: where the Quran in the app comes from. -->
    <string name="quran_sources_title">About and sources</string>
    <string name="quran_sources_intro">The Quran here is copied exactly from its sources, never changed, retyped or generated. These are its sources, with their credits and terms.</string>
    <string name="quran_sources_text_title">The Quran\'s text</string>
    <string name="quran_sources_text_body">Tanzil Quran Text (Uthmani), from the Tanzil Project, which produces and verifies it with a group of specialists. Licensed under Creative Commons Attribution 3.0: it may be copied only as it is, never changed. Its notice, in full:</string>
    <string name="quran_sources_metadata_title">Surahs and juz</string>
    <string name="quran_sources_translation_title">Translation</string>
    <string name="quran_sources_translation_body"><xliff:g id="name" example="Saheeh International">%1$s</xliff:g>, by <xliff:g id="translator" example="Saheeh International">%2$s</xliff:g>, in <xliff:g id="language" example="English">%3$s</xliff:g>, from the Tanzil Project.</string>
    <string name="quran_sources_font_title">Arabic typeface</string>
    <string name="quran_sources_font_body">Amiri Quran 1.003, by the Amiri Project Authors (Khaled Hosny, Sebastian Kosch), made for the Quran\'s text. Licensed under the SIL Open Font License 1.1.</string>
    <string name="quran_sources_app_title">In this app</string>
    <string name="quran_sources_downloaded">Downloaded from Tanzil on <xliff:g id="date" example="20 October 2026">%1$s</xliff:g>. The app updates them when Tanzil does.</string>
    <string name="quran_sources_version">Data version <xliff:g id="version" example="73c20fa2f325b9d2">%1$s</xliff:g></string>
    <string name="quran_sources_link_tanzil">tanzil.net</string>
    <string name="quran_sources_link_updates">Changes to the text: tanzil.net/updates</string>
    <string name="quran_sources_link_metadata">Tanzil\'s Quran metadata</string>
    <string name="quran_sources_link_translations">Tanzil\'s translations</string>
    <string name="quran_sources_link_amiri">The Amiri project</string>
    <string name="quran_sources_link_ofl">SIL Open Font License</string>
    <!-- What a link does, for TalkBack. -->
    <string name="quran_sources_open_link">Open in the browser</string>
    <!-- Choosing the translation. -->
    <string name="quran_translation_title">Translation</string>
    <!-- The reading settings' button: the translation read now. -->
    <string name="quran_translation_open">Translation: <xliff:g id="name" example="Saheeh International">%1$s</xliff:g></string>
    <!-- Who made a translation, and its language. -->
    <string name="quran_translation_by"><xliff:g id="translator" example="Saheeh International">%1$s</xliff:g> · <xliff:g id="language" example="English">%2$s</xliff:g></string>
    <string name="quran_translation_switching">Putting the new translation in place. The Quran screen shows how far it\'s got.</string>
    <string name="quran_translation_terms">Terms of <xliff:g id="name" example="Saheeh International">%1$s</xliff:g></string>
    <string name="quran_translation_updated">Last updated by its source: <xliff:g id="date" example="April 24, 2011">%1$s</xliff:g></string>
    <string name="quran_translation_bundled">Translations come with the app, so the Quran reads without a connection.</string>
    <!-- Searching the whole Quran. -->
    <string name="quran_search_title">Search the Quran</string>
    <string name="quran_search_placeholder">Surah, 2:255, or words</string>
    <string name="quran_search_hint">Find a surah by its name or number, an ayah by its reference (2:255), or ayahs by words in their English translation or in Arabic, with or without its marks.</string>
    <string name="quran_search_none">Nothing found for “<xliff:g id="query" example="zzqx">%1$s</xliff:g>”</string>
    <plurals name="quran_search_surahs">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> surah</item>
        <item quantity="other"><xliff:g id="count" example="3">%d</xliff:g> surahs</item>
    </plurals>
    <plurals name="quran_search_ayahs">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> ayah</item>
        <item quantity="other"><xliff:g id="count" example="42">%d</xliff:g> ayahs</item>
    </plurals>
    <!-- When a search finds more ayahs than it shows. -->
    <string name="quran_search_ayahs_capped">The first <xliff:g id="count" example="200">%1$d</xliff:g> ayahs: add a word to narrow it</string>
    <!-- A found ayah's reference: its surah's name, then surah:ayah. -->
    <string name="quran_search_reference"><xliff:g id="name" example="Al-Baqara">%1$s</xliff:g> <xliff:g id="surah" example="2">%2$d</xliff:g>:<xliff:g id="ayah" example="255">%3$d</xliff:g></string>
    <!-- The bookmarks screen. -->
    <string name="quran_bookmarks">Bookmarks</string>
    <string name="quran_bookmarks_none_title">No bookmarks yet</string>
    <string name="quran_bookmarks_none_body">Tap an ayah as you read, then Bookmark. It will be here, ready to go back to.</string>
    <!-- A surah's heading there: its number and English name. -->
    <string name="quran_bookmarks_surah"><xliff:g id="number" example="2">%1$d</xliff:g>. <xliff:g id="name" example="Al-Baqara">%2$s</xliff:g></string>
    <string name="quran_bookmark_ayah">Ayah <xliff:g id="surah" example="2">%1$d</xliff:g>:<xliff:g id="ayah" example="255">%2$d</xliff:g></string>
    <string name="quran_bookmark_remove">Remove the bookmark on <xliff:g id="surah" example="2">%1$d</xliff:g>:<xliff:g id="ayah" example="255">%2$d</xliff:g></string>
    <!-- The reader's top-bar action: its sizes, spacing and what each ayah shows. -->
    <string name="quran_reader_settings">Reading settings</string>
    <!-- The Quran screen's two lists. -->
    <string name="quran_tab_surahs">Surahs</string>
    <string name="quran_tab_juz">Juz</string>
    <!-- A juz's row: its number, and the surah (its English name, then its number) and ayah it starts at. -->
    <string name="quran_juz_title">Juz <xliff:g id="number" example="2">%d</xliff:g></string>
    <string name="quran_juz_from">From <xliff:g id="surah_name" example="Al-Baqara">%1$s</xliff:g> <xliff:g id="surah" example="2">%2$d</xliff:g>:<xliff:g id="ayah" example="142">%3$d</xliff:g></string>
    <string name="quran_juz_spoken">Juz <xliff:g id="number" example="2">%1$d</xliff:g>, from <xliff:g id="surah_name" example="Al-Baqara">%2$s</xliff:g>, ayah <xliff:g id="ayah" example="142">%3$d</xliff:g></string>
    <!-- The fast-scroll strip beside the list: each mark, as TalkBack reads it. -->
    <string name="quran_jump_to_surah">Jump to surah <xliff:g id="number" example="20">%d</xliff:g></string>
    <!-- Going straight to an ayah: the dialog over the list. -->
    <string name="quran_go_title">Go to surah and ayah</string>
    <string name="quran_go_surah">Surah (1 to 114)</string>
    <string name="quran_go_ayah">Ayah (blank for the first)</string>
    <string name="quran_go_button">Go</string>
    <string name="quran_go_cancel">Cancel</string>
    <string name="quran_go_no_surah">There are <xliff:g id="count" example="114">%d</xliff:g> surahs</string>
    <string name="quran_go_no_ayah">Surah <xliff:g id="surah" example="1">%1$d</xliff:g> has <xliff:g id="count" example="7">%2$d</xliff:g> ayahs</string>
    <!-- What TalkBack says for a surah's row, one button: number, English name, meaning, place, ayahs. -->
    <string name="quran_surah_spoken"><xliff:g id="number" example="2">%1$d</xliff:g>. <xliff:g id="name" example="Al-Baqara">%2$s</xliff:g>, <xliff:g id="meaning" example="The Cow">%3$s</xliff:g>. <xliff:g id="place" example="Medinan">%4$s</xliff:g>, <xliff:g id="count" example="286 ayahs">%5$s</xliff:g></string>
</resources>
