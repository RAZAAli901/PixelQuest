    <string name="pq_coach_next_brief"><xliff:g id="time" example="8:48 AM">%1$s</xliff:g> · next brief in <xliff:g id="wait" example="~6h">%2$s</xliff:g></string>
    <string name="pq_coach_brief_ready"><xliff:g id="time" example="8:48 AM">%1$s</xliff:g> · new brief ready</string>

