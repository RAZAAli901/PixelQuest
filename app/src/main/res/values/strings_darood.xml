<?xml version="1.0" encoding="utf-8"?>
<!--
    Darood Party's text (docs/darood-design.md), all in this file.

    For translators:
    - "Darood" is a proper name: keep the form your language uses for it.
    - Usernames are shown as typed by players, after an @: never translate them.
    - <xliff:g> marks a value filled in by the app; keep it, move it where your grammar needs it,
      and leave what's inside unchanged. Its example shows what the app puts there.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The side menu's entry, and the feature's home screen. -->
    <string name="menu_darood">Darood Party</string>
    <string name="darood_title">Darood Party</string>
    <string name="darood_empty_title">No parties yet</string>
    <string name="darood_empty_body">Start a party with 2 to 30 friends, post how many Darood you read each day, and reach a goal together. Or wait for a friend to invite you by your username.</string>
    <string name="darood_create">Create a party</string>
    <!-- Signed out: parties need an account. The button opens the usual sign-in (the Account screen). -->
    <string name="darood_signed_out_title">Sign in to join a party</string>
    <string name="darood_signed_out_body">Darood Parties are shared with friends, so they need an account. Sign in with Google or an emailed code.</string>
    <string name="darood_sign_in">Sign in</string>
    <!-- The party list: one row per party. -->
    <plurals name="darood_members">
        <item quantity="one"><xliff:g id="count" example="1">%1$d</xliff:g> member</item>
        <item quantity="other"><xliff:g id="count" example="12">%1$d</xliff:g> members</item>
    </plurals>
    <string name="darood_total">Total <xliff:g id="total" example="2,450">%1$s</xliff:g></string>
    <string name="darood_progress"><xliff:g id="total" example="2,450">%1$s</xliff:g> of <xliff:g id="milestone" example="10,000">%2$s</xliff:g></string>
    <string name="darood_no_milestone">No milestone yet</string>
    <string name="darood_finished">Finished</string>
    <string name="darood_open_party">Open the party</string>
    <!-- Creating a party. -->
    <string name="darood_create_title">New party</string>
    <string name="darood_create_name">Party name</string>
    <string name="darood_create_name_placeholder">e.g. Friday circle</string>
    <string name="darood_create_name_counter"><xliff:g id="used" example="12">%1$d</xliff:g>/<xliff:g id="max" example="40">%2$d</xliff:g></string>
    <string name="darood_create_name_too_short">At least 2 characters.</string>
    <string name="darood_create_name_too_long">At most 40 characters.</string>
    <!-- Invitations, at the top of the list. -->
    <string name="darood_invites_title">Invitations</string>
    <string name="darood_invite_to">You\'re invited to join</string>
    <string name="darood_invite_accept">Accept</string>
    <string name="darood_invite_decline">Decline</string>
    <string name="darood_invite_gone">That invitation isn\'t there any more: it may have been withdrawn, or the party is full or finished.</string>
    <string name="darood_list_failed">Something went wrong. Pull down to try again.</string>
    <string name="darood_parties_title">Your parties</string>
    <string name="darood_list_offline">Couldn\'t reach the server. Showing what this phone has.</string>
    <!-- A party's own screen; the chat comes to it later. -->
    <string name="darood_party_info">Party info</string>
    <string name="darood_chat_soon">The party\'s chat is on its way.</string>
    <!-- A username as shown on the profile and in the side menu. -->
    <string name="darood_username_handle">@<xliff:g id="name" example="aria_k">%1$s</xliff:g></string>
    <string name="darood_username_profile_label">Darood Party username</string>
    <string name="darood_username_profile_change">Change your username</string>
    <!-- The username screen: claiming or changing the name others invite you by. -->
    <string name="darood_username_title">Your username</string>
    <string name="darood_username_intro">Friends invite you to a Darood Party by your username. It isn\'t listed anywhere: share it with the people you want to read with.</string>
    <string name="darood_username_label">Username</string>
    <string name="darood_username_placeholder">e.g. aria_k</string>
    <string name="darood_username_rules">3 to 20 letters, numbers or _. You can change it once every 30 days.</string>
    <string name="darood_username_save">Save username</string>
    <string name="darood_username_saving">Saving…</string>
    <string name="darood_username_checking">Checking…</string>
    <string name="darood_username_available">@<xliff:g id="name" example="aria_k">%1$s</xliff:g> is free</string>
    <string name="darood_username_taken">@<xliff:g id="name" example="aria_k">%1$s</xliff:g> is taken. Try another one.</string>
    <string name="darood_username_unknown">Couldn\'t check right now. Check your connection.</string>
    <string name="darood_username_yours">That\'s your username.</string>
    <string name="darood_username_current">Your username is @<xliff:g id="name" example="aria_k">%1$s</xliff:g>.</string>
    <string name="darood_username_changeable_at">You can change it from <xliff:g id="date" example="18 Nov 2026">%1$s</xliff:g>.</string>
    <string name="darood_username_too_short">At least 3 characters.</string>
    <string name="darood_username_too_long">At most 20 characters.</string>
    <string name="darood_username_invalid_characters">Only letters a to z, numbers and _.</string>
    <string name="darood_username_reserved">That name is reserved. Try another one.</string>
    <string name="darood_username_error_taken">Someone took that name just now. Try another one.</string>
    <string name="darood_username_error_invalid">That name isn\'t allowed. Try another one.</string>
    <string name="darood_username_error_too_soon">You changed your username recently. You can change it again from <xliff:g id="date" example="18 Nov 2026">%1$s</xliff:g>.</string>
    <string name="darood_username_error_offline">Couldn\'t save. Check your connection and try again.</string>
</resources>
