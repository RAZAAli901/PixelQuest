<?xml version="1.0" encoding="utf-8"?>
<!--
    Darood Party's text (docs/darood-design.md), all in this file.

    For translators:
    - "Darood" is a proper name: keep the form your language uses for it.
    - Usernames are shown as typed by players, after an @: never translate them.
    - <xliff:g> marks a value filled in by the app; keep it, move it where your grammar needs it,
      and leave what's inside unchanged. Its example shows what the app puts there.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- The side menu's entry, and the feature's home screen. -->
    <string name="menu_darood">Darood Party</string>
    <string name="darood_title">Darood Party</string>
    <string name="darood_empty_title">No parties yet</string>
    <string name="darood_empty_body">Start a party with 2 to 30 friends, post how many Darood you read each day, and reach a goal together. Or wait for a friend to invite you by your username.</string>
    <string name="darood_create">Create a party</string>
    <!-- Signed out: parties need an account. The button opens the usual sign-in (the Account screen). -->
    <string name="darood_signed_out_title">Sign in to join a party</string>
    <string name="darood_signed_out_body">Darood Parties are shared with friends, so they need an account. Sign in with Google or an emailed code.</string>
    <string name="darood_sign_in">Sign in</string>
