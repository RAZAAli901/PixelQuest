<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: plain http is allowed to a Supabase stack running on this computer
  (npx supabase start; see docs/LOCAL_SUPABASE.md). The emulator reaches the computer as 10.0.2.2.
  Everything else, and every release build, stays https-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
